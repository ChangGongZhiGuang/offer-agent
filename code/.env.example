# OpenAI 兼容模型端点 (OpenAI / DeepSeek / Qwen / 本地 vLLM 通用)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=deepseek-chat
EMBED_MODEL_NAME=text-embedding-3-small

# MySQL (Phase 1+ 使用)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=interviewforge

# 有界性参数可在此覆盖 roles.yaml 默认值 (留空则用默认)
TOKEN_BUDGET=
MAX_TURNS=

# 向量库: memory(默认,每次启动重建内存索引,仅 embed SEED 题) | chroma(持久化, 对整个题库增量 embedding)
# 开 chroma 前需 pip install chromadb; 首次启动全量 embed 一次, 之后启动只补新增/改题干的题
# 换 EMBED_MODEL_NAME 后旧向量失配, 需删 INTERVIEWFORGE_CHROMA_PATH 目录重建
INTERVIEWFORGE_VECTOR_STORE=chroma
INTERVIEWFORGE_CHROMA_PATH=.interviewforge_chroma

# 题库/认证/历史等持久化开关: 设 mysql 落库持久化; 缺省 inmemory 重启即丢
INTERVIEWFORGE_QUESTION_BANK=mysql

# 接口文档开关: 1=开启 /docs /redoc /openapi.json (默认, 方便本地调试)
# 公网生产务必设为 0, 避免向外界暴露全部接口清单 (含 admin 路由)
INTERVIEWFORGE_EXPOSE_DOCS=1
